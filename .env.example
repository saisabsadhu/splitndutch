# Copy to .env.local and fill in. Nothing here is required to try the app locally.

# Public address people open (used in emails, invite links, sitemap). No trailing slash.
APP_URL=http://localhost:3000

# Email via Resend (https://resend.com). Free tier: 3,000 emails/month.
# Without a key, emails are printed to the server log instead, which is handy in development.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend. onboarding@resend.dev works for testing to your own inbox only.
EMAIL_FROM="SplitnDutch <hello@yourdomain.in>"
# Shown on the privacy page and used as reply-to and grievance contact.
CONTACT_EMAIL=hello@yourdomain.in

# Demo household + "Try the demo" button. Defaults to on in dev, off in production.
# Turn it OFF for a real launch: demo accounts are shared by every visitor.
DEMO_MODE=0

# Where the SQLite database lives (relative to the project, or absolute).
DATA_DIR=data

# CSV mirror of the database, one sheet per table (amounts in paise/cents).
LEDGER_DIR=data/ledger-sheets
# Rewrite the CSVs a few seconds after every change.
LEDGER_AUTOSYNC=1
# Then git commit + push inside LEDGER_DIR. Make LEDGER_DIR a clone of your PRIVATE ledger repo first.
LEDGER_GIT_PUSH=0

# Calendar timezone for "today".
NEXT_PUBLIC_APP_TZ=Asia/Kolkata

# Link to the source shown in the footer/About page.
REPO_URL=https://github.com/saisabsadhu/splitndutch
